---
import Layout from '../layouts/Layout.astro';
import FooterModelo from '../components/FooterModelo.astro';
import ProductCard from '../components/ProductCard.astro';
import Newsletter from '../components/Newsletter.astro';
import PageHeader from '../components/PageHeader.astro';

import p01 from '../assets/products/01-kit-bioaqua-vitamina-c.jpg';
import p02 from '../assets/products/02-kit-bioaqua-aguacate.jpg';
import p03 from '../assets/products/03-kit-bioaqua-camelia.jpg';
import p04 from '../assets/products/04-crema-vitamina-c.jpg';
import p05 from '../assets/products/05-tonico-ceramidas.jpg';
import p06 from '../assets/products/06-crema-rose.jpg';
import p07 from '../assets/products/07-crema-centella.jpg';
import p08 from '../assets/products/08-crema-acido-hialuronico.jpg';
import p09 from '../assets/products/09-crema-arroz.jpg';
import p10 from '../assets/products/10-serum-arroz.jpg';
import p11 from '../assets/products/11-exfoliante-arroz.jpg';
import p12 from '../assets/products/12-tonico-arroz.jpg';
import p13 from '../assets/products/13-protector-solar.jpg';
import p14 from '../assets/products/14-protector-ojeras.jpg';

const products = [
  { image: p01, alt: "Kit Bioaqua Vitamina C con Ácido Hialurónico",                 category: "Skincare Preparación", name: "Kit Bioaqua Vitamina C con Ácido Hialurónico", price: "$37.900 COP", tag: "Bestseller" },
  { image: p02, alt: "Kit Bioaqua Aguacate",                                         category: "Skincare Preparación", name: "Kit Bioaqua Aguacate",                            price: "$37.900 COP" },
  { image: p03, alt: "Kit Bioaqua Camelia",                                          category: "Skincare Preparación", name: "Kit Bioaqua Camelia",                             price: "$37.900 COP" },
  { image: p04, alt: "Crema Facial Vitamina C con Ácido Hialurónico BQY18922",      category: "Skincare Preparación", name: "Crema Facial Vitamina C con Ácido Hialurónico BQY18922", price: "$14.900 COP", tag: "Nuevo" },
  { image: p05, alt: "Tónico de Ceramidas y Ácido Hialurónico",                      category: "Skincare Preparación", name: "Tónico de Ceramidas y Ácido Hialurónico",         price: "$12.900 COP" },
  { image: p06, alt: "Crema Facial Rose Ref BQY42613",                               category: "Skincare Preparación", name: "Crema Facial Rose Ref BQY42613",                  price: "$14.000 COP" },
  { image: p07, alt: "Crema Facial Centella Ref BQY12050",                           category: "Skincare Preparación", name: "Crema Facial Centella Ref BQY12050",              price: "$14.500 COP" },
  { image: p08, alt: "Crema Facial Ácido Hialurónico Ref 18861",                     category: "Skincare Preparación", name: "Crema Facial Ácido Hialurónico Ref 18861",        price: "$14.500 COP" },
  { image: p09, alt: "Crema Facial Arroz Bioaqua Ref BQY56303",                      category: "Skincare Preparación", name: "Crema Facial Arroz Bioaqua Ref BQY56303",         price: "$14.500 COP" },
  { image: p10, alt: "Serum Arroz Bioaqua Ref BQY80535",                             category: "Skincare Preparación", name: "Serum Arroz Bioaqua Ref BQY80535",                price: "$11.500 COP" },
  { image: p11, alt: "Exfoliante Facial Arroz Bioaqua Ref BQY7519",                  category: "Skincare Preparación", name: "Exfoliante Facial Arroz Bioaqua Ref BQY7519",     price: "$14.500 COP" },
  { image: p12, alt: "Tónico Facial Arroz Bioaqua Ref BQY41005",                      category: "Skincare Preparación", name: "Tónico Facial Arroz Bioaqua Ref BQY41005",         price: "$14.000 COP" },
  { image: p13, alt: "Protector Solar Ref No. SD55856",                              category: "Skincare Preparación", name: "Protector Solar Ref No. SD55856",                 price: "$11.500 COP" },
  { image: p14, alt: "Protector de Ojeras Bioaqua Ref BQY90423",                     category: "Skincare Preparación", name: "Protector de Ojeras Bioaqua Ref BQY90423",        price: "$14.900 COP" },
];

const categories = [
  "Todo",
  "Maquillaje Rostro",
  "Ojos & Cejas",
  "Labios",
  "Skincare Preparación",
  "Lencería Fina",
];

const brands = ["Bioaqua", "Sadoer", "Montoc", "Bloomshell", "Rhode"];

const totalProducts = products.length;
---

<Layout
  title="Catálogo — DistriSam Make Up"
  activePage="catalogo"
  description="Descubre nuestra exclusiva selección de maquillaje profesional y lencería, diseñada para realzar tu belleza natural con la más alta calidad."
>
  <!-- Page Header -->
  <PageHeader
    title="Catálogo de Productos"
    description="Descubre nuestra exclusiva selección de maquillaje profesional y lencería, diseñada para realzar tu belleza natural con la más alta calidad."
  />

  <!-- Catalog Layout -->
  <section class="catalog-section" data-reveal>
    <div class="container">
      <div class="catalog-layout">
        <!-- Sidebar -->
        <aside class="sidebar">
          <div class="mobile-search">
            <input type="text" placeholder="Buscar en catálogo..." />
            <span class="material-symbols-outlined">search</span>
          </div>

          <div class="sidebar-section">
            <h3 class="sidebar-title">Categorías</h3>
            <ul class="filter-list">
              {categories.map((c, i) => (
                <li>
                  <button class:list={["filter-btn", { active: i === 0 }]} type="button">{c}</button>
                </li>
              ))}
            </ul>
          </div>

          <div class="sidebar-section">
            <h3 class="sidebar-title">Marcas</h3>
            <div class="brand-list">
              {brands.map((b) => (
                <label class="brand-label">
                  <input type="checkbox" /> {b}
                </label>
              ))}
            </div>
          </div>
        </aside>

        <!-- Product Area -->
        <div class="product-area">
          <div class="product-controls">
            <p class="product-count">Mostrando 1-{totalProducts} de {totalProducts} productos</p>
            <div class="sort-control">
              <span>Ordenar por:</span>
              <select>
                <option>Destacados</option>
                <option>Precio: Menor a Mayor</option>
                <option>Precio: Mayor a Menor</option>
                <option>Nuevos Ingresos</option>
              </select>
            </div>
          </div>

          <div class="product-grid">
            {products.map((p) => <ProductCard {...p} />)}
          </div>

          <!-- Pagination -->
          <nav class="pagination" aria-label="Paginación del catálogo">
            <button type="button" aria-label="Página anterior" disabled>
              <span class="material-symbols-outlined">chevron_left</span>
            </button>
            <button type="button" class="active" aria-current="page">1</button>
            <button type="button">2</button>
            <button type="button">3</button>
            <button type="button" disabled>…</button>
            <button type="button" aria-label="Página siguiente">
              <span class="material-symbols-outlined">chevron_right</span>
            </button>
          </nav>
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <Newsletter />

  <FooterModelo />
</Layout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Catalog Layout */
  .catalog-section {
    padding: 0;
  }
  .catalog-layout {
    display: flex;
    gap: 2rem;
    padding: 4rem 0;
  }

  /* Sidebar */
  .sidebar {
    width: 240px;
    flex-shrink: 0;
  }
  .sidebar-section {
    margin-bottom: 2.5rem;
  }
  .sidebar-title {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    color: var(--fg);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }
  .filter-list {
    list-style: none;
  }
  .filter-list li {
    margin-bottom: 0.75rem;
  }
  .filter-btn {
    background: none;
    border: none;
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--muted);
    cursor: pointer;
    padding: 0.25rem 0;
    transition: all 0.2s;
    width: 100%;
    text-align: left;
  }
  .filter-btn:hover,
  .filter-btn.active {
    color: var(--accent-deep);
    font-weight: 600;
  }
  .filter-btn.active {
    border-bottom: 2px solid var(--accent-deep);
  }
  .brand-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .brand-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 14px;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.2s;
  }
  .brand-label:hover {
    color: var(--accent-deep);
  }
  .brand-label input[type="checkbox"] {
    accent-color: var(--accent-deep);
    width: 16px;
    height: 16px;
  }

  /* Mobile Search */
  .mobile-search {
    display: none;
    position: relative;
    margin-bottom: 1.5rem;
  }
  .mobile-search input {
    width: 100%;
    padding: 0.75rem 2.5rem 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--cream);
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--fg);
    outline: none;
  }
  .mobile-search input:focus {
    border-color: var(--accent-deep);
  }
  .mobile-search .material-symbols-outlined {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--muted);
    font-size: 20px;
  }

  /* Product Area */
  .product-area {
    flex: 1;
    min-width: 0;
  }
  .product-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .product-count {
    font-size: 14px;
    color: var(--muted);
  }
  .sort-control {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 14px;
    color: var(--muted);
  }
  .sort-control select {
    background: transparent;
    border: none;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    color: var(--fg);
    cursor: pointer;
    outline: none;
  }

  /* Product Grid */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  /* Pagination */
  .pagination {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 3rem;
  }
  .pagination button {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    background: var(--surface);
    color: var(--muted);
    font-family: var(--font-body);
    font-size: 14px;
    cursor: pointer;
    transition: all 0.2s;
  }
  .pagination button:hover:not(:disabled) {
    border-color: var(--accent-deep);
    color: var(--accent-deep);
  }
  .pagination button.active {
    background: var(--matte-black);
    color: var(--surface);
    border-color: var(--matte-black);
  }
  .pagination button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .pagination button .material-symbols-outlined {
    font-size: 20px;
  }

  @media (max-width: 767px) {
    .catalog-layout {
      flex-direction: column;
    }
    .sidebar {
      width: 100%;
    }
    .mobile-search {
      display: block;
    }
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }
  @media (max-width: 480px) {
    .product-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
