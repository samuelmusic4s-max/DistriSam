---
import NavigationModelo from '../components/NavigationModelo.astro';
import FooterModelo from '../components/FooterModelo.astro';
import ProductCard from '../components/ProductCard.astro';
import { Image } from 'astro:assets';

import imgHero from '../assets/products/01-kit-bioaqua-vitamina-c.jpg';
import imgAguacate from '../assets/products/02-kit-bioaqua-aguacate.jpg';
import imgCeramidas from '../assets/products/05-tonico-ceramidas.jpg';
import imgSolar from '../assets/products/13-protector-solar.jpg';
import imgArroz from '../assets/products/10-serum-arroz.jpg';
import imgRose from '../assets/products/06-crema-rose.jpg';
import imgParallax from '../assets/products/03-kit-bioaqua-camelia.jpg'; 
import imgPhilosophy from '../assets/products/08-crema-acido-hialuronico.jpg'; 
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Landing Modelo — DistriSam Make Up</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style is:global>
        :root {
            --bg-eye-care: #F9F6F0;
            --text-charcoal: #1A1A1A;
            --gold: #C5A059;
        }

        body {
            background-color: var(--bg-eye-care);
            color: var(--text-charcoal);
            font-family: 'Outfit', sans-serif;
            margin: 0; padding: 0;
            overflow-x: hidden; scroll-behavior: smooth;
        }

        ::-webkit-scrollbar { display: none; }
        html { scrollbar-width: none; }
        
        .container { max-width: 1400px; margin: 0 auto; padding: 0 1.5rem; box-sizing: border-box; }
        
        /* Animaciones */
        [data-reveal="blur-up"] {
            opacity: 0; transform: translateY(40px); filter: blur(12px);
            transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
        }
        [data-reveal="blur-up"].is-revealed {
            opacity: 1; transform: translateY(0); filter: blur(0);
        }
        .stagger-item {
            opacity: 0; transform: translateY(30px); filter: blur(8px);
            transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
            transition-delay: calc(var(--stagger-idx) * 0.15s);
        }
        [data-stagger].is-revealed .stagger-item {
            opacity: 1; transform: translateY(0); filter: blur(0);
        }

        /* Estructuras dinámicas de fondo */
        .mesh-gradient-1 {
            background: radial-gradient(at 0% 0%, rgba(197,160,89,0.15) 0px, transparent 60%),
                        radial-gradient(at 100% 100%, rgba(200,180,140,0.2) 0px, transparent 60%);
        }
        .mesh-gradient-dark {
            background: radial-gradient(at 0% 0%, rgba(197,160,89,0.3) 0px, transparent 70%),
                        radial-gradient(at 100% 100%, rgba(26,26,26,1) 0px, transparent 70%),
                        #1A1A1A;
        }
    </style>
</head>
<body>

<NavigationModelo activePage="inicio" />

<main>
    <!-- 1. HERO -->
    <section class="modelo-hero">
        <div class="hero-bg">
            <Image src={imgHero} alt="DistriSam" class="hero-img" loading="eager" fetchpriority="high" />
            <div class="hero-overlay"></div>
        </div>
        <div class="hero-content" data-reveal="blur-up">
            <h1 class="hero-title">Florece desde adentro. Brilla hacia afuera.</h1>
            <p class="hero-desc">Porque mereces sentirte hermosa en tu propia piel. Encuentra la magia del cuidado personal para consentirte, con opciones de compra al detal o al por mayor.</p>
            <a href="#solucion" class="btn-primary-magnetic">Inicia tu viaje aquí</a>
        </div>
    </section>

    <!-- 3. LA DOLENCIA (Pain Point) -->
    <section class="pain-point-section container">
        <div class="pain-point-content" data-reveal="blur-up">
            <span class="section-subtitle">De corazón a corazón</span>
            <h2 class="pain-title">¿Cuántas veces has buscado algo que realmente te haga sentir tú misma?</h2>
            <p class="pain-desc">
                Sabemos lo que se siente invertir ilusiones en una crema que no funciona, en un maquillaje que se desvanece, o en prendas que no abrazan tu cuerpo como lo mereces. <strong>Estamos aquí para cuidarte, escucharte y devolverte la confianza en cada detalle.</strong>
            </p>
        </div>
    </section>

    <!-- 4. SEPARADOR PARALLAX -->
    <div class="parallax-separator">
        <Image src={imgParallax} alt="Textura Piel" class="parallax-img" />
        <div class="parallax-overlay"></div>
    </div>

    <!-- 5. LA SOLUCIÓN (Mesh Gradient 1) -->
    <section id="solucion" class="solution-section mesh-gradient-1">
        <div class="container solution-content">
            <div class="solution-text" data-reveal="blur-up">
                <span class="section-subtitle">DistriSam Make Up</span>
                <h2 class="solution-title">Queremos ser el refugio donde encuentras tu luz.</h2>
                <p class="solution-desc">
                    Seleccionamos cada producto con amor y rigor para regalarte esos preciosos minutos de paz frente al espejo, ofreciéndote lo mejor tanto en compras individuales como al por mayor.
                </p>
            </div>
            
            <!-- Bento Box de Beneficios -->
            <div class="bento-grid" data-stagger>
                <div class="bento-item">
                    <span class="material-symbols-outlined bento-icon">storefront</span>
                    <h3>Al detal y al por mayor</h3>
                    <p>Te acompañamos unidad por unidad si buscas consentirte, o con precios especiales si necesitas mayor volumen.</p>
                </div>
                <div class="bento-item">
                    <span class="material-symbols-outlined bento-icon">favorite_border</span>
                    <h3>Todo lo que mereces</h3>
                    <p>Un universo completo pensado para ti: desde las gotas puras de un buen serum facial, hasta la delicadeza de la lencería fina.</p>
                </div>
                <div class="bento-item bento-wide">
                    <span class="material-symbols-outlined bento-icon">verified_user</span>
                    <h3>Un trato de transparencia absoluta</h3>
                    <p>Sabemos lo sagrada que es tu piel. Por eso, distribuimos exclusivamente productos originales y seguros. Cuidamos tu bienestar como si fuera el nuestro, alejándote de falsificaciones o fórmulas dañinas.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- 6. FILOSOFÍA VISUAL (Split Layout) -->
    <section class="split-philosophy container">
        <div class="split-text" data-reveal="blur-up">
            <h2 class="split-title">Tres universos creados para abrazar tu esencia.</h2>
            <p>No se trata solo de productos; se trata de cómo te hacen sentir. Celebramos tu autenticidad en cada paso de tu día, desde el amanecer hasta el anochecer.</p>
            <ul class="check-list">
                <li><span class="material-symbols-outlined">spa</span> <strong>El abrazo a tu piel:</strong> Fórmulas que sanan, hidratan y protegen tu rostro.</li>
                <li><span class="material-symbols-outlined">brush</span> <strong>Los colores de tu alma:</strong> Maquillaje vibrante para expresar tu luz al mundo.</li>
                <li><span class="material-symbols-outlined">styler</span> <strong>Amor propio en cada hilo:</strong> Lencería íntima para enamorarte de tu propio cuerpo.</li>
                <li><span class="material-symbols-outlined">inventory_2</span> <strong>A tu medida:</strong> Disponible por unidad o al por mayor, según lo necesites.</li>
            </ul>
        </div>
        <div class="split-image-wrapper" data-reveal="blur-up">
            <Image src={imgPhilosophy} alt="Filosofía" class="split-image" />
        </div>
    </section>

    <!-- 7. COLECCIONES ESTRELLA (Bestsellers) -->
    <section id="rutina" class="routine-section container">
        <div class="section-header" data-reveal="blur-up">
            <span class="section-subtitle">Lo más amado</span>
            <h2 class="section-title">Nuestras Colecciones Estrella</h2>
            <p class="section-desc">Un vistazo a los productos favoritos de nuestras clientas en cada categoría.</p>
        </div>
        
        <div class="product-expansive-grid" data-stagger>
            <!-- Usamos las fotos base como placeholder visual, pero los textos son del inventario real -->
            <ProductCard image={imgHero} alt="Skincare" category="Skincare (Bioaqua)" name="Kit Vitamina C + Hialurónico" price="Ver Catálogo" tag="Top Piel" />
            <ProductCard image={imgArroz} alt="Maquillaje" category="Paletas (Kevin & Coco)" name="Paleta Libro KYC 48 Tonos" price="Ver Catálogo" tag="Top Color" />
            <ProductCard image={imgRose} alt="Brochas" category="Accesorios" name="Libro Brochas x 24 Unidades" price="Ver Catálogo" tag="Top Beauty" />
            <ProductCard image={imgCeramidas} alt="Lencería" category="Lencería & Pijamas" name="Pijama Encaje Fino Rosa" price="Ver Catálogo" tag="Top Íntimo" />
        </div>
    </section>

    <!-- 8. BENEFICIOS -->
    <section class="benefits-section">
        <div class="container">
            <div class="section-header" data-reveal="blur-up">
                <span class="section-subtitle">Por qué elegirnos</span>
                <h2 class="section-title">Nuestra promesa contigo</h2>
            </div>
            <div class="benefits-grid" data-stagger>
                <div class="benefit-card">
                    <span class="material-symbols-outlined benefit-icon">health_and_safety</span>
                    <h3>Piel Segura</h3>
                    <p>Evita riesgos. Distribuimos productos con registro sanitario y estándares internacionales, alejándote de falsificaciones peligrosas.</p>
                </div>
                <div class="benefit-card">
                    <span class="material-symbols-outlined benefit-icon">savings</span>
                    <h3>Inversión Inteligente</h3>
                    <p>No pagues por marcas infladas por marketing. Traemos opciones de alto rendimiento a precios justos y competitivos.</p>
                </div>
                <div class="benefit-card">
                    <span class="material-symbols-outlined benefit-icon">auto_awesome</span>
                    <h3>Resultados Reales</h3>
                    <p>Nuestra selección se basa en evidencia y tendencias probadas en la industria del cuidado personal.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- 9. FINAL CTA (Mesh Gradient Dark) -->
    <section class="final-cta mesh-gradient-dark">
        <div class="container cta-content" data-reveal="blur-up">
            <h2>Tu mejor versión te está esperando.</h2>
            <p>Da el primer paso para consentirte como realmente mereces.</p>
            <a href="/catalogo" class="btn-primary-magnetic btn-light">Entrar a la Tienda Oficial</a>
        </div>
    </section>

    <!-- 10. FAQ INTERACTIVO (Antes del Footer) -->
    <section class="faq-section container">
        <div class="faq-inner" data-reveal="blur-up">
            <h2 class="section-title">Preguntas Frecuentes</h2>
            <p class="faq-desc">Todo lo que necesitas saber antes de realizar tu compra.</p>
            <div class="faq-accordion">
                <!-- Se usa details y summary nativos de HTML para acordeones sin JS extra -->
                <details class="faq-item" name="faq">
                    <summary>¿Hacen envíos a nivel nacional? <span class="material-symbols-outlined faq-icon">expand_more</span></summary>
                    <div class="faq-content">
                        <p>Sí, llegamos a cualquier ciudad de Colombia a través de transportadoras seguras y aliadas. Tu pedido viaja protegido.</p>
                    </div>
                </details>
                <details class="faq-item" name="faq">
                    <summary>¿Los productos son 100% originales? <span class="material-symbols-outlined faq-icon">expand_more</span></summary>
                    <div class="faq-content">
                        <p>Totalmente. Somos distribuidores que filtramos rigurosamente a nuestros proveedores para garantizar la autenticidad de cada lote.</p>
                    </div>
                </details>
                <details class="faq-item" name="faq">
                    <summary>¿Venden al por mayor? <span class="material-symbols-outlined faq-icon">expand_more</span></summary>
                    <div class="faq-content">
                        <p>Sí, ofrecemos opciones de compra al detal para tu uso personal, y precios especiales al por mayor si deseas surtir tu propio emprendimiento.</p>
                    </div>
                </details>
            </div>
        </div>
    </section>

    <!-- TRUST STRIP (Social Proof) -->
    <div class="trust-strip" data-reveal="blur-up">
        <div class="container trust-inner">
            <span><span class="material-symbols-outlined">local_shipping</span> Viajamos por toda Colombia</span>
            <span><span class="material-symbols-outlined">workspace_premium</span> Calidad garantizada con amor</span>
            <span><span class="material-symbols-outlined">support_agent</span> Asesoría cálida 24/7</span>
            <span><span class="material-symbols-outlined">storefront</span> Ventas al por mayor y detal</span>
        </div>
    </div>
</main>

<FooterModelo />

<script>
  const observerOptions: IntersectionObserverInit = { root: null, rootMargin: '0px 0px -10% 0px', threshold: 0.1 };
  const scrollObserver = new IntersectionObserver((entries, observer) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-revealed');
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  document.querySelectorAll<HTMLElement>('[data-reveal="blur-up"]').forEach(el => scrollObserver.observe(el));
  document.querySelectorAll<HTMLElement>('[data-stagger]').forEach(container => {
    const children = Array.from(container.children) as HTMLElement[];
    children.forEach((child, index) => {
      child.style.setProperty('--stagger-idx', index.toString());
      child.classList.add('stagger-item');
    });
    scrollObserver.observe(container);
  });
</script>

<style>
  /* Hero */
  .modelo-hero { position: relative; height: 95vh; display: flex; align-items: center; justify-content: center; text-align: center; overflow: hidden; }
  .hero-bg { position: absolute; inset: 0; }
  .hero-img { width: 100%; height: 100%; object-fit: cover; animation: slowZoom 30s infinite alternate ease-in-out; }
  @keyframes slowZoom { 0% { transform: scale(1); } 100% { transform: scale(1.1); } }
  .hero-overlay { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(26,26,26,0.2), rgba(26,26,26,0.95)); }
  .hero-content { position: relative; z-index: 1; max-width: 1000px; color: #F9F6F0; padding: 0 1.5rem; }
  .hero-title { font-size: clamp(3.5rem, 7vw, 6.5rem); font-weight: 700; line-height: 1.1; margin-bottom: 1.5rem; letter-spacing: -0.02em; }
  .hero-title em { color: var(--gold); font-style: italic; font-weight: 400; }
  .hero-desc { font-size: clamp(1.2rem, 2.5vw, 1.4rem); font-weight: 300; opacity: 0.9; max-width: 700px; margin: 0 auto 3rem; line-height: 1.6; }
  
  /* Botones */
  .btn-primary-magnetic {
      display: inline-block; padding: 1.25rem 3.5rem; background: var(--gold); color: #111;
      font-weight: 700; text-transform: uppercase; letter-spacing: 0.15em; border-radius: 99px; text-decoration: none;
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s; font-size: 0.95rem;
  }
  .btn-primary-magnetic:hover { transform: translateY(-4px); box-shadow: 0 15px 30px rgba(197, 160, 89, 0.3); }
  .btn-light { background: #F9F6F0; color: #1A1A1A; }
  .btn-light:hover { box-shadow: 0 15px 30px rgba(249, 246, 240, 0.2); }

  /* Trust Strip */
  .trust-strip { background: var(--text-charcoal); color: #F9F6F0; padding: 1.5rem 0; font-size: 0.85rem; font-weight: 500; letter-spacing: 0.05em; text-transform: uppercase; }
  .trust-inner { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; }
  .trust-inner span { display: flex; align-items: center; gap: 0.5rem; }

  /* Secciones Globales */
  .section-subtitle { display: block; font-size: 0.85rem; letter-spacing: 0.25em; text-transform: uppercase; color: var(--gold); margin-bottom: 1.5rem; font-weight: 700; }
  .section-title { font-size: clamp(2.5rem, 5vw, 3.5rem); font-weight: 700; line-height: 1.1; color: var(--text-charcoal); margin-bottom: 1.5rem; }

  /* Pain Point */
  .pain-point-section { padding: 10rem 0; text-align: center; }
  .pain-point-content { max-width: 900px; margin: 0 auto; }
  .pain-title { font-size: clamp(2.5rem, 5vw, 4.5rem); font-weight: 700; margin-bottom: 2.5rem; line-height: 1.1; color: var(--text-charcoal); }
  .pain-desc { font-size: 1.4rem; font-weight: 300; line-height: 1.8; color: #444; }
  .pain-desc strong { font-weight: 600; color: var(--text-charcoal); }

  /* Parallax Separator */
  .parallax-separator { position: relative; height: 60vh; overflow: hidden; background: #1A1A1A; }
  .parallax-img { width: 100%; height: 100%; object-fit: cover; }
  .parallax-overlay { position: absolute; inset: 0; background: rgba(26,26,26,0.85); } 

  /* Solución & Bento Grid */
  .solution-section { padding: 8rem 0 10rem; }
  .solution-content { max-width: 1000px; margin: 0 auto; text-align: center; }
  .solution-desc { font-size: 1.25rem; font-weight: 300; line-height: 1.8; color: #333; margin-bottom: 5rem; max-width: 800px; margin-inline: auto; }
  .bento-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; text-align: left; }
  .bento-item { background: rgba(255,255,255,0.6); padding: 3rem; border-radius: 1.5rem; backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.4); }
  .bento-wide { grid-column: 1 / -1; }
  .bento-icon { font-size: 3rem; color: var(--gold); margin-bottom: 1.5rem; }
  .bento-item h3 { font-size: 1.5rem; font-weight: 600; margin-bottom: 1rem; color: var(--text-charcoal); }
  .bento-item p { font-size: 1.1rem; color: #555; line-height: 1.6; }

  /* Split Philosophy */
  .split-philosophy { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center; padding: 10rem 0; }
  .split-title { font-size: 3rem; font-weight: 700; margin-bottom: 2rem; line-height: 1.1; }
  .split-text p { font-size: 1.2rem; color: #555; line-height: 1.7; margin-bottom: 2rem; }
  .check-list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 1rem; }
  .check-list li { display: flex; align-items: center; gap: 1rem; font-size: 1.1rem; font-weight: 500; }
  .check-list .material-symbols-outlined { color: var(--gold); }
  .split-image-wrapper { border-radius: 2rem; overflow: hidden; height: 600px; }
  .split-image { width: 100%; height: 100%; object-fit: cover; }

  /* Rutina */
  .routine-section { padding: 5rem 0 10rem; }
  .section-header { text-align: center; margin-bottom: 5rem; }
  .product-expansive-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 3rem; }

  /* Beneficios */
  .benefits-section { background: #FFFFFF; padding: 10rem 0; }
  .benefits-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 3rem; margin-top: 4rem; }
  .benefit-card { padding: 3rem; background: var(--bg-eye-care); border-radius: 1.5rem; border: 1px solid var(--border); transition: transform 0.3s; }
  .benefit-card:hover { transform: translateY(-5px); }
  .benefit-icon { font-size: 3rem; color: var(--gold); margin-bottom: 1.5rem; }
  .benefit-card h3 { font-size: 1.4rem; font-weight: 700; color: var(--text-charcoal); margin-bottom: 1rem; }
  .benefit-card p { font-size: 1.1rem; line-height: 1.7; color: #555; }

  /* FAQ Interactivo */
  .faq-section { padding: 8rem 0; }
  .faq-inner { max-width: 800px; margin: 0 auto; }
  .faq-desc { font-size: 1.2rem; color: #555; margin-bottom: 3rem; }
  .faq-accordion { display: flex; flex-direction: column; gap: 1rem; }
  .faq-item { background: #FFFFFF; border: 1px solid var(--border); border-radius: 1rem; overflow: hidden; transition: box-shadow 0.3s; }
  .faq-item:hover { box-shadow: 0 10px 30px rgba(0,0,0,0.03); }
  .faq-item summary { 
      padding: 1.5rem 2rem; font-size: 1.25rem; font-weight: 600; color: var(--text-charcoal); 
      cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; 
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-icon { transition: transform 0.3s; color: var(--gold); }
  .faq-item[open] .faq-icon { transform: rotate(180deg); }
  .faq-content { padding: 0 2rem 1.5rem; }
  .faq-content p { font-size: 1.1rem; color: #555; line-height: 1.7; margin: 0; }

  /* Final CTA */
  .final-cta { padding: 12rem 0; text-align: center; color: #F9F6F0; }
  .cta-content h2 { font-size: clamp(3rem, 6vw, 5rem); font-weight: 700; margin-bottom: 1.5rem; line-height: 1.1; }
  .cta-content p { font-size: 1.5rem; opacity: 0.8; margin-bottom: 3rem; }

  @media (max-width: 1024px) {
      .split-philosophy { grid-template-columns: 1fr; }
      .bento-grid { grid-template-columns: 1fr; }
      .trust-inner { justify-content: center; }
  }
</style>
</body>
</html>
