---
import Layout from '../layouts/Layout.astro';
import FooterModelo from '../components/FooterModelo.astro';
import ContactForm from '../components/ContactForm.svelte';
import PageHeader from '../components/PageHeader.astro';
---

<Layout title="Contacto — DistriSam Make Up" activePage="contacto">
  <!-- Page Header -->
  <PageHeader
    title="Hablemos de Belleza"
    description="Estamos aquí para asesorarte y brindarte los mejores productos para realzar tu belleza. Contáctanos para pedidos, asesorías o consultas al por mayor."
  />

  <!-- Contact Grid -->
  <section class="container" data-reveal>
    <div class="contact-grid">
      <!-- Left: Info + Map -->
      <div>
        <div class="contact-info-card">
          <h2>Información Directa</h2>

          <a href="https://wa.me/573027431560" class="contact-item" style="display:flex">
            <div class="contact-icon"><span class="material-symbols-outlined">chat</span></div>
            <div class="contact-detail">
              <p class="label">WhatsApp</p>
              <p class="value">+57 302 7431560</p>
            </div>
          </a>

          <a href="https://tiktok.com/@distrisam.makeup" class="contact-item" style="display:flex">
            <div class="contact-icon"><span class="material-symbols-outlined">play_circle</span></div>
            <div class="contact-detail">
              <p class="label">TikTok</p>
              <p class="value">@distrisam.makeup</p>
            </div>
          </a>

          <hr class="contact-divider">

          <div class="contact-item" style="display:flex">
            <div class="contact-icon"><span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1">location_on</span></div>
            <div class="contact-detail">
              <p class="label">Ubicación</p>
              <p class="value">Manzana i Casa 7, Panorámico 2, Pasto, Colombia</p>
            </div>
          </div>
        </div>

        <div class="map-container" style="margin-top:1.5rem">
          <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuBidpB-Jsr5X1HF8N9Ox42snF9evH7na9E8UOAZ506Qecr7No-B8mQiByqStzT3KEsdSvMRHwUc83IG1HgI3yPuxm69-Pa5yIIqEmIiWcRW427C7prhs7174rCEMWIjdrZBXAimrCvzPL1EgDp53MGcdM0V0OycbK4ZjoCL-AlHKIGCvQN6h8zc82wILGJSIxNIehHXy_ryXBb7O4QfWpUjldwZGlGLrLYItaNTZJSSdtkHD4ZNIye2gcHgxLqQc3hZyrai5RtieDs" alt="Mapa de ubicación">
          <div class="map-pin"></div>
        </div>
      </div>

      <!-- Right: Form -->
      <ContactForm client:visible />
    </div>
  </section>

  <FooterModelo />
</Layout>

<style>
  /* Contact Grid */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: 2rem 0 5rem;
  }

  /* Contact Info */
  .contact-info-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    padding: 2.5rem;
    box-shadow: 0 10px 30px rgba(197, 160, 89, 0.05);
    position: relative;
    overflow: hidden;
  }
  .contact-info-card::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 128px;
    height: 128px;
    background: var(--soft-blush);
    border-radius: 0 0 0 100%;
    opacity: 0.5;
  }
  .contact-info-card h2 {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 1.5rem;
    position: relative;
  }
  .contact-item {
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    position: relative;
  }
  .contact-item:last-child { margin-bottom: 0; }
  .contact-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--cream);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-deep);
    font-size: 24px;
    flex-shrink: 0;
    transition: all 0.3s;
  }
  .contact-item:hover .contact-icon {
    background: var(--accent-deep);
    color: var(--surface);
  }
  .contact-item a:hover .contact-icon {
    background: var(--accent-deep);
    color: var(--surface);
  }
  .contact-detail .label {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.25rem;
  }
  .contact-detail .value {
    font-size: 18px;
    color: var(--fg);
    transition: color 0.2s;
  }
  .contact-item:hover .contact-detail .value,
  .contact-item a:hover .contact-detail .value {
    color: var(--accent-deep);
  }
  .contact-divider {
    border: none;
    border-top: 1px solid var(--border);
    margin: 1.5rem 0;
  }

  /* Map */
  .map-container {
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid var(--border);
    height: 256px;
    position: relative;
    box-shadow: 0 10px 30px rgba(197, 160, 89, 0.05);
  }
  .map-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(0.3) opacity(0.85);
  }
  .map-pin {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 16px;
    height: 16px;
    background: var(--accent-deep);
    border-radius: 50%;
    box-shadow: 0 0 0 8px rgba(119, 90, 25, 0.2);
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 8px rgba(119, 90, 25, 0.2); }
    50% { box-shadow: 0 0 0 16px rgba(119, 90, 25, 0.1); }
  }

  @media (min-width: 768px) {
    .contact-grid { grid-template-columns: 5fr 7fr; }
  }
</style>
