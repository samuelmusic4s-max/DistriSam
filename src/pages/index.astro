            <ProductCard
              image="https://lh3.googleusercontent.com/aida-public/AB6AXuBrcJvlCe0XOKQx1OAY1TC3rvNefkEMK_j3vIFYJzZMuKmQrpTDIzERg94dDoPDdXhvyNKsn6N72_DorL_UG2h9QIIjo6FoH6XZZ7QjDY9eeBq1eVIVh6FuyxjHasd43O42_MuhbdYeoHBe2T7_k1jTQHA90sIYFm-nU-Pxhon5YV5QoqTBoeVBea0vSkD0yfWfqUhd7_8dCCWNSPLRW6vfrETSz2f7Nticv6NwTRXdZLLaQt_YpgfOZ2nHVqMq7KA2iD0fpCYvfmE"
              alt="Tónico Ceramidas"
              category="Cuidado Facial"
              name="Tónico de Ceramidas y Ácido Hialurónico"
              price="$12.900 COP"
              tag="Nuevo"
            />
            <ProductCard
              image="https://lh3.googleusercontent.com/aida-public/AB6AXuDIR0goTMzwNVlyMPq4gQ5MABWGR44bHW0VgZKVMSwo28pyld1A7phtP9IS1Bgre_1DE-toJnGURG56RfusTHcajGpVYptK85ZgNOBKffOboHhrQ3bo_yOErZQGLg_UaugTRPXezZWi5v6AJemtw2ETBE4w48Y6FPComXDgFxrSf_h3_xPYH5SPIvXEi1I9SpsoFiHK4XQq9qZhGUM3OnZFwWV8fquYYm8dmsNunQPEmDWPCI3EqkOoMaIStKQLMvUuzDwEjvvPBNM"
              alt="Protector Solar"
