            />
          </div>
        </div>
      </section>
    </Layout>

    <script>
      // Reveal on scroll
      const reveals = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -50px 0px' }
        );
        reveals.forEach((el) => io.observe(el));
      } else {
        reveals.forEach((el) => el.classList.add('is-revealed'));
      }

      // Stagger distribution: assign --stagger index to each child
      document.querySelectorAll('[data-stagger]').forEach((container) => {
        const children = container.children;
        for (let i = 0; i < children.length; i++) {
          (children[i] as HTMLElement).style.setProperty('--stagger', String(i));
        }
        const stIO = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                stIO.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -30px 0px' }
        );
        stIO.observe(container);
      });
    </script>

    <style>
      /* Hero */
      .hero {
        padding: 5rem 0;
        text-align: center;
        background: var(--cream);
        position: relative;
        overflow: hidden;
      }
      .hero::before {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        width: 40%;
        height: 100%;
        background: var(--soft-blush);
        opacity: 0.4;
        filter: blur(60px);
        transform: skewX(-12deg) translateX(50%);
      }
      .hero-content {
        position: relative;
        z-index: 1;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }
      .hero-logo-wrap {
        text-align: center;
        margin: 0 auto 2rem;
      }
      .hero h1 {
        font-family: var(--font-display);
        font-size: clamp(28px, 4vw, 48px);
        font-weight: 700;
        color: var(--fg);
        letter-spacing: -0.02em;
        margin-bottom: 1rem;
        max-width: 700px;
        margin-left: auto;
        margin-right: auto;
      }
      .hero h1 em {
        color: var(--accent);
        font-style: italic;
      }
      .hero p {
        font-size: 18px;
        color: var(--muted);
        max-width: 600px;
        margin: 0 auto 2rem;
        line-height: 1.7;
      }
      .hero-ctas {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
      }
      .btn-primary {
        display: inline-flex;
        align-items: center;
        padding: 0.875rem 2rem;
        background: var(--matte-black);
        color: var(--surface);
        font-family: var(--font-body);
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        border-radius: 0.25rem;
        transition: background 0.3s;
      }
      .btn-primary:hover { background: var(--accent-deep); }
      .btn-secondary {
        display: inline-flex;
        align-items: center;
        padding: 0.875rem 2rem;
        background: transparent;
        color: var(--accent);
        border: 1px solid var(--accent);
        font-family: var(--font-body);
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        border-radius: 0.25rem;
        transition: all 0.3s;
      }
      .btn-secondary:hover { background: var(--accent); color: var(--surface); }

      /* Common Sections */
      .section { padding: 5rem 0; }
      .section-label {
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--accent);
        text-align: center;
        margin-bottom: 0.5rem;
      }
      .section-title {
        font-family: var(--font-display);
        font-size: clamp(24px, 3vw, 32px);
        font-weight: 600;
        text-align: center;
        margin-bottom: 0.75rem;
      }
      .section-divider {
        width: 64px;
        height: 1px;
        background: var(--gold-shimmer);
        margin: 0 auto 3rem;
      }

      /* Bento Grid */
      .bento-grid {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: 1.5rem;
      }
      .bento-large {
        grid-column: span 12;
        position: relative;
        border-radius: 0.5rem;
        overflow: hidden;
        border: 1px solid var(--border);
        background: var(--surface);
        height: 400px;
        cursor: pointer;
      }
      .bento-large img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.7s;
      }
      .bento-large:hover img { transform: scale(1.05); }
      .bento-large .overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(26,26,26,0.7) 0%, transparent 60%);
      }
      .bento-large .content {
        position: absolute;
        bottom: 0;
        left: 0;
        padding: 2rem;
        color: var(--surface);
      }
      .bento-large .tag {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        background: var(--bg);
        color: var(--accent-deep);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        border-radius: 0.25rem;
        margin-bottom: 0.75rem;
      }
      .bento-large h3 {
        font-family: var(--font-display);
        font-size: 24px;
        font-weight: 600;
        margin-bottom: 0.5rem;
      }
      .bento-large p {
        font-size: 14px;
        opacity: 0.85;
        max-width: 400px;
      }
      .bento-large .link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 1rem;
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--surface);
      }
      .bento-large .link .material-symbols-outlined { font-size: 16px; transition: transform 0.2s; }
      .bento-large .link:hover .material-symbols-outlined { transform: translateX(4px); }

      .bento-stack {
        grid-column: span 12;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }
      .bento-small {
        position: relative;
        height: 250px;
        border-radius: 0.5rem;
        overflow: hidden;
        border: 1px solid var(--border);
        background: var(--surface);
        cursor: pointer;
      }
      .bento-small img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.7s;
      }
      .bento-small:hover img { transform: scale(1.05); }
      .bento-small .overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(26,26,26,0.6) 0%, transparent 80%);
      }
      .bento-small .content {
        position: absolute;
        bottom: 0;
        left: 0;
        padding: 1.5rem;
        color: var(--surface);
      }
      .bento-small h3 { font-family: var(--font-display); font-size: 20px; font-weight: 600; margin-bottom: 0.25rem; }
      .bento-small .link { display: inline-flex; align-items: center; gap: 0.25rem; font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--surface); }

      .bento-text {
        height: 250px;
        background: var(--soft-blush);
        border-radius: 0.5rem;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        border: 1px solid var(--border);
        transition: background 0.5s ease;
      }
      .bento-text:hover { background: var(--cream); }
      .bento-text .icon { font-size: 32px; color: var(--accent); margin-bottom: 0.5rem; }
      .bento-text h3 { font-family: var(--font-display); font-size: 20px; font-weight: 600; margin-bottom: 0.25rem; }
      .bento-text p { font-size: 13px; color: var(--muted); margin-bottom: 1rem; }
      .bento-text .link-text { font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent-deep); font-weight: 600; }

      /* Product Grid */
      .productos-section {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 0.75rem;
        padding: 3rem 2rem;
      }
      .productos-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 2.5rem;
      }
      .ver-todo {
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--accent-deep);
        border-bottom: 1px solid var(--accent);
        padding-bottom: 0.25rem;
      }
      .product-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
      }

      /* Reveal on scroll */
      [data-reveal] {
        opacity: 0;
        transform: translateY(16px);
        transition: opacity 700ms ease, transform 700ms ease;
      }
      [data-reveal].is-revealed {
        opacity: 1;
        transform: translateY(0);
      }

      /* Stagger distribution */
      [data-stagger] > * {
        opacity: 0;
        transform: translateY(12px);
        transition: opacity 600ms ease, transform 600ms ease;
        transition-delay: calc(var(--stagger, 0) * 90ms);
      }
      [data-stagger].is-revealed > * {
        opacity: 1;
        transform: translateY(0);
      }

      @media (prefers-reduced-motion: reduce) {
        [data-reveal],
        [data-stagger] > * {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }

      /* Desktop layout overrides */
      @media (min-width: 768px) {
        .bento-grid {
          grid-template-columns: repeat(12, 1fr);
        }
        .bento-large {
          grid-column: span 8;
          height: 400px;
        }
        .bento-stack {
          grid-column: span 4;
          height: 400px;
        }
        .product-grid {
          grid-template-columns: repeat(4, 1fr);
        }
      }
    </style>