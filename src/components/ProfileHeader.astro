---
import Logo from './Logo.astro';

interface Props {
  name: string;
  handle: string;
  bio: string;
}

const { name, handle, bio } = Astro.props;
---

<div class="profile">
  <Logo size="md" ring badge class="profile-avatar" />
  <h1 class="profile-name">{name}</h1>
  <p class="profile-handle">{handle}</p>
  <p class="profile-bio">{bio}</p>
</div>

<style>
  .profile {
    text-align: center;
    margin-bottom: 2.5rem;
    animation: profile-fade-in 900ms ease-out both;
  }

  .profile-avatar {
    margin: 0 auto 1.5rem;
  }

  .profile-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 26px;
    color: var(--fg);
    margin-bottom: 0.35rem;
    letter-spacing: -0.01em;
  }
  .profile-handle {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 0.85rem;
    letter-spacing: 0.02em;
  }
  .profile-bio {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.65;
    max-width: 320px;
    margin: 0 auto;
  }

  @keyframes profile-fade-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .profile { animation: none; }
  }
</style>
