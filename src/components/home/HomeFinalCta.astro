<section class="final-cta mesh-gradient-dark">
    <div class="container cta-content" data-reveal="blur-up">
        <h2>Tu mejor versión te está esperando.</h2>
        <p>Da el primer paso para consentirte como realmente mereces.</p>
        <a href="https://drive.google.com/drive/folders/1zpCZNG4K5TVL329bn4_T86Kv-3FNNiFy?usp=drive_link" target="_blank" rel="noopener noreferrer" class="btn-primary-magnetic btn-light">Mira nuestro catálogo</a>
    </div>
</section>
<style>
  .final-cta { padding: 6rem 0; text-align: center; color: #F9F6F0; }
  .cta-content h2 { font-size: clamp(2.5rem, 5vw, 4rem); font-family: var(--font-display, serif); font-weight: 500; margin-bottom: 1.5rem; letter-spacing: -0.02em; }
  .cta-content p { font-size: 1.25rem; opacity: 0.9; margin-bottom: 2.5rem; max-width: 600px; margin-inline: auto; }
  .btn-primary-magnetic {
      display: inline-flex; align-items: center; justify-content: center; padding: 1.25rem 2.5rem;
      text-decoration: none; font-size: 1.125rem;
      font-weight: 600; border-radius: 999px; transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s;
  }
  .btn-light {
      background: #F9F6F0; color: #1A1A1A;
      box-shadow: 0 10px 30px rgba(249, 246, 240, 0.2);
  }
  .btn-light:hover { transform: translateY(-4px) scale(1.02); box-shadow: 0 15px 40px rgba(249, 246, 240, 0.4); }
  .mesh-gradient-dark {
      background: radial-gradient(at 0% 0%, rgba(197,160,89,0.3) 0px, transparent 70%),
                  radial-gradient(at 100% 100%, rgba(26,26,26,1) 0px, transparent 70%),
                  #1A1A1A;
  }
</style>
