---
import ProductCard from '../ProductCard.astro';
import imgHero from '../../assets/products/01-kit-bioaqua-vitamina-c.jpg';
import imgPaleta from '../../assets/products/15-paleta-kyc.jpg';
import imgBrochas from '../../assets/products/16-brochas-24.jpg';
import imgPijama from '../../assets/products/17-pijama-rosa.jpg';
---
<section id="rutina" class="routine-section container">
    <div class="section-header" data-reveal="blur-up">
        <span class="section-subtitle">¿Qué ofrecemos?</span>
        <h2 class="section-title">Categorías Destacadas</h2>
        <p class="section-desc">Descubre todo lo que tenemos para ti. Hemos organizado nuestros mejores productos en cuatro categorías principales para facilitar tu búsqueda.</p>
    </div>
    
    <div class="carousel-container" data-reveal="blur-up">
        <div class="carousel-track">
            <div class="carousel-group">
                <div class="carousel-item">
                    <ProductCard 
                        image={imgHero} 
                        alt="Cuidado Facial" 
                        category="Línea 01" 
                        name="Skincare & Cuidado Facial" 
                        description="Todo lo que tu piel necesita para brillar y mantenerse saludable todos los días." 
                        tag="Top Ventas" 
                    />
                </div>
                <div class="carousel-item">
                    <ProductCard 
                        image={imgPaleta} 
                        alt="Maquillaje" 
                        category="Línea 02" 
                        name="Maquillaje & Color" 
                        description="Paletas, bases y labiales de alta cobertura para resaltar tu belleza natural." 
                        tag="Tendencia" 
                    />
                </div>
                <div class="carousel-item">
                    <ProductCard 
                        image={imgBrochas} 
                        alt="Accesorios" 
                        category="Línea 03" 
                        name="Herramientas & Accesorios" 
                        description="Brochas, esponjas y kits profesionales para lograr un acabado perfecto." 
                        tag="Esenciales" 
                    />
                </div>
                <div class="carousel-item">
                    <ProductCard 
                        image={imgPijama} 
                        alt="Lencería" 
                        category="Línea 04" 
                        name="Lencería & Pijamas" 
                        description="Prendas íntimas y pijamas súper suaves pensadas para tu comodidad." 
                        tag="Íntimo" 
                    />
                </div>
            </div>
            <!-- Duplicate for infinite scroll -->
            <div class="carousel-group" aria-hidden="true">
                <div class="carousel-item">
                    <ProductCard 
                        image={imgHero} 
                        alt="Cuidado Facial" 
                        category="Línea 01" 
                        name="Skincare & Cuidado Facial" 
                        description="Todo lo que tu piel necesita para brillar y mantenerse saludable todos los días." 
                        tag="Top Ventas" 
                    />
                </div>
                <div class="carousel-item">
                    <ProductCard 
                        image={imgPaleta} 
                        alt="Maquillaje" 
                        category="Línea 02" 
                        name="Maquillaje & Color" 
                        description="Paletas, bases y labiales de alta cobertura para resaltar tu belleza natural." 
                        tag="Tendencia" 
                    />
                </div>
                <div class="carousel-item">
                    <ProductCard 
                        image={imgBrochas} 
                        alt="Accesorios" 
                        category="Línea 03" 
                        name="Herramientas & Accesorios" 
                        description="Brochas, esponjas y kits profesionales para lograr un acabado perfecto." 
                        tag="Esenciales" 
                    />
                </div>
                <div class="carousel-item">
                    <ProductCard 
                        image={imgPijama} 
                        alt="Lencería" 
                        category="Línea 04" 
                        name="Lencería & Pijamas" 
                        description="Prendas íntimas y pijamas súper suaves pensadas para tu comodidad." 
                        tag="Íntimo" 
                    />
                </div>
            </div>
        </div>
    </div>
</section>
<style is:global>
  .routine-section { padding: 4rem 0 6rem; overflow: hidden; }
  .section-header { text-align: center; margin-bottom: 4rem; }
  .section-subtitle { display: inline-block; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent-deep, #775a19); font-weight: 600; margin-bottom: 0.75rem; }
  .section-title { font-size: clamp(2rem, 4vw, 2.75rem); font-family: var(--font-display, serif); font-weight: 500; color: var(--fg, #1a1a1a); margin-bottom: 1rem; letter-spacing: -0.01em; }
  .section-desc { color: var(--muted, #555); font-size: 1.125rem; max-width: 600px; margin: 0 auto; line-height: 1.7; }
  
  .carousel-container {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    padding: 1rem 0 3rem;
  }
  
  .carousel-track {
    display: flex;
    gap: 2rem;
    width: max-content;
  }
  
  .carousel-group {
    display: flex;
    gap: 2rem;
    animation: scroll 25s linear infinite;
  }
  
  .carousel-container:hover .carousel-group {
    animation-play-state: paused;
  }
  
  .carousel-item {
    width: 280px;
    flex-shrink: 0;
  }

  @keyframes scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(calc(-100% - 2rem)); }
  }

  @media (max-width: 768px) {
      .routine-section { padding: 3rem 0 4rem; }
      .section-title { font-size: clamp(2rem, 8vw, 2.5rem); }
      .carousel-item { width: 260px; scroll-snap-align: center; }
      
      .carousel-container {
        position: relative;
        padding: 0 1.5rem;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scroll-snap-type: x mandatory;
      }
      .carousel-container::after {
        content: '';
        position: absolute;
        right: 0;
        top: 0;
        bottom: 0;
        width: 3rem;
        background: linear-gradient(to right, transparent, var(--bg-eye-care, #F9F6F0));
        pointer-events: none;
        z-index: 2;
      }
      .carousel-container::-webkit-scrollbar {
        height: 4px;
      }
      .carousel-container::-webkit-scrollbar-track {
        background: transparent;
      }
      .carousel-container::-webkit-scrollbar-thumb {
        background: var(--accent, #c5a059);
        border-radius: 4px;
      }
      .carousel-track {
        width: 100%;
        gap: 1.5rem;
      }
      .carousel-group {
        animation: none; /* Quitamos la animación infinita */
        gap: 1.5rem;
      }
      /* Ocultamos el grupo duplicado en móvil porque usamos scroll nativo */
      .carousel-group[aria-hidden="true"] {
        display: none;
      }
  }
  @media (min-width: 769px) {
      .carousel-item { width: 320px; }
  }
</style>
