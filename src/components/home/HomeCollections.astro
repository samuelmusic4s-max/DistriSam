---
import ProductCard from '../ProductCard.astro';
import imgHero from '../../assets/products/01-kit-bioaqua-vitamina-c.jpg';
import imgPaleta from '../../assets/products/15-paleta-kyc.jpg';
import imgBrochas from '../../assets/products/16-brochas-24.jpg';
import imgPijama from '../../assets/products/17-pijama-rosa.jpg';
---
<section id="rutina" class="routine-section container">
    <div class="section-header" data-reveal="blur-up">
        <span class="section-subtitle">Lo más amado</span>
        <h2 class="section-title">Nuestras Colecciones Estrella</h2>
        <p class="section-desc">Un vistazo a los productos favoritos de nuestras clientas en cada categoría.</p>
    </div>
    
    <div class="carousel-container" data-reveal="blur-up">
        <div class="carousel-track">
            <div class="carousel-group">
                <div class="carousel-item">
                    <ProductCard image={imgHero} alt="Skincare" category="Skincare (Bioaqua)" name="Kit Vitamina C + Hialurónico" price="Ver Catálogo" tag="Top Piel" />
                </div>
                <div class="carousel-item">
                    <ProductCard image={imgPaleta} alt="Maquillaje" category="Paletas (Kevin & Coco)" name="Paleta Libro KYC 48 Tonos" price="Ver Catálogo" tag="Top Color" />
                </div>
                <div class="carousel-item">
                    <ProductCard image={imgBrochas} alt="Brochas" category="Accesorios" name="Libro Brochas x 24 Unidades" price="Ver Catálogo" tag="Top Beauty" />
                </div>
                <div class="carousel-item">
                    <ProductCard image={imgPijama} alt="Lencería" category="Lencería & Pijamas" name="Pijama Encaje Fino Rosa" price="Ver Catálogo" tag="Top Íntimo" />
                </div>
            </div>
            <!-- Duplicate for infinite scroll -->
            <div class="carousel-group" aria-hidden="true">
                <div class="carousel-item">
                    <ProductCard image={imgHero} alt="Skincare" category="Skincare (Bioaqua)" name="Kit Vitamina C + Hialurónico" price="Ver Catálogo" tag="Top Piel" />
                </div>
                <div class="carousel-item">
                    <ProductCard image={imgPaleta} alt="Maquillaje" category="Paletas (Kevin & Coco)" name="Paleta Libro KYC 48 Tonos" price="Ver Catálogo" tag="Top Color" />
                </div>
                <div class="carousel-item">
                    <ProductCard image={imgBrochas} alt="Brochas" category="Accesorios" name="Libro Brochas x 24 Unidades" price="Ver Catálogo" tag="Top Beauty" />
                </div>
                <div class="carousel-item">
                    <ProductCard image={imgPijama} alt="Lencería" category="Lencería & Pijamas" name="Pijama Encaje Fino Rosa" price="Ver Catálogo" tag="Top Íntimo" />
                </div>
            </div>
        </div>
    </div>
</section>
<style is:global>
  .routine-section { padding: 4rem 0 6rem; overflow: hidden; }
  .section-header { text-align: center; margin-bottom: 4rem; }
  .section-subtitle { display: inline-block; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent-deep, #775a19); font-weight: 600; margin-bottom: 0.75rem; }
  .section-title { font-size: clamp(2rem, 4vw, 2.75rem); font-family: var(--font-display, serif); font-weight: 500; color: var(--fg, #1a1a1a); margin-bottom: 1rem; letter-spacing: -0.01em; }
  .section-desc { color: var(--muted, #555); font-size: 1.125rem; max-width: 600px; margin: 0 auto; line-height: 1.7; }
  
  .carousel-container {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    padding: 1rem 0 3rem;
  }
  
  .carousel-track {
    display: flex;
    gap: 2rem;
    width: max-content;
  }
  
  .carousel-group {
    display: flex;
    gap: 2rem;
    animation: scroll 25s linear infinite;
  }
  
  .carousel-container:hover .carousel-group {
    animation-play-state: paused;
  }
  
  .carousel-item {
    width: 280px;
    flex-shrink: 0;
  }

  @keyframes scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(calc(-100% - 2rem)); }
  }

  @media (max-width: 768px) {
      .routine-section { padding: 3rem 0 4rem; }
      .section-title { font-size: clamp(2rem, 8vw, 2.5rem); }
      .carousel-item { width: 260px; scroll-snap-align: center; }
      
      /* En móvil, hacemos que sea scrolleable táctil nativo en vez de animado */
      .carousel-container {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scroll-snap-type: x mandatory;
        padding-left: 1rem;
        padding-right: 1rem;
      }
      .carousel-track {
        width: 100%;
        gap: 1.5rem;
      }
      .carousel-group {
        animation: none; /* Quitamos la animación infinita */
        gap: 1.5rem;
      }
      /* Ocultamos el grupo duplicado en móvil porque usamos scroll nativo */
      .carousel-group[aria-hidden="true"] {
        display: none;
      }
  }
  @media (min-width: 769px) {
      .carousel-item { width: 320px; }
  }
</style>
