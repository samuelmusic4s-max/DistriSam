<div class="trust-strip" data-reveal="blur-up">
    <div class="container trust-inner">
        <span><span class="material-symbols-outlined">local_shipping</span> Viajamos por toda Colombia</span>
        <span><span class="material-symbols-outlined">workspace_premium</span> Calidad garantizada con amor</span>
        <span><span class="material-symbols-outlined">support_agent</span> Asesoría cálida 24/7</span>
        <span><span class="material-symbols-outlined">storefront</span> Ventas al por mayor y detal</span>
    </div>
</div>
<style>
  .trust-strip { background: var(--bg-eye-care, #F9F6F0); padding: 1.5rem 0; border-top: 1px solid var(--border, #eee); border-bottom: 1px solid var(--border, #eee); }
  .trust-inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1.5rem; }
  .trust-inner span { display: flex; align-items: center; gap: 0.5rem; font-size: 0.95rem; font-weight: 500; color: var(--fg, #1a1a1a); letter-spacing: 0.02em; }
  .trust-inner .material-symbols-outlined { color: var(--accent, #c5a059); font-size: 20px; }
  @media (max-width: 1024px) {
      .trust-inner { justify-content: center; }
  }
</style>
