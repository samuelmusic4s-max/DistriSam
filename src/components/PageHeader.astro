---
// PageHeader component - reusable across pages
interface Props {
  label?: string;
  title: string;
  description?: string;
  showDivider?: boolean;
}

const { label, title, description, showDivider = false } = Astro.props;
---

<section class="page-header" data-reveal>
  <div class="container">
    {label && <p class="label">{label}</p>}
    <h1>{title}</h1>
    {description && <p class="description">{description}</p>}
    {showDivider && <div class="divider"></div>}
  </div>
</section>

<style>
  .page-header {
    padding: 5rem 0 3rem;
    text-align: center;
  }
  .page-header .label {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent-deep);
    margin-bottom: 1rem;
  }
  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(32px, 5vw, 64px);
    font-weight: 700;
    color: var(--fg);
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
  }
  .page-header .description {
    font-size: 18px;
    color: var(--muted);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.7;
  }
  .page-header .divider {
    width: 96px;
    height: 1px;
    background: var(--gold-shimmer);
    margin: 1.5rem auto 0;
  }
</style>
