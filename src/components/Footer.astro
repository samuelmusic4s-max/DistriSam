---
interface Props {
  brand: string;
  slogan: string;
}

const { brand, slogan } = Astro.props;
---

<div class="footer">
  <p class="brand">{brand}</p>
  <p class="slogan">{slogan}</p>
</div>

<style>
  .footer {
    text-align: center;
    font-size: 12px;
    color: var(--muted);
    opacity: 0.7;
    margin-top: auto;
    padding-top: 2rem;
  }
  .footer .brand {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    color: var(--fg);
    opacity: 1;
    margin-bottom: 0.25rem;
  }
  .footer .slogan {
    font-size: 12px;
  }
</style>
