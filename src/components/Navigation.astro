---
interface Props {
    activePage: 'inicio' | 'catalogo' | 'quienes-somos' | 'contacto';
}

const {activePage} = Astro.props;
---
<nav>
    <div class="container nav-inner">
        <a href="/" class="nav-brand">
            DistriSam Make Up
        </a>
        <ul class="nav-links">
            <li><a href="/" class={activePage === 'inicio' ? 'active' : ''}>Inicio</a></li>
            <li><a href="/catalogo" class={activePage === 'catalogo' ? 'active' : ''}>Catálogo</a></li>
            <li><a href="/quienes-somos" class={activePage === 'quienes-somos' ? 'active' : ''}>Quiénes Somos</a></li>
            <li><a href="/contacto" class={activePage === 'contacto' ? 'active' : ''}>Contacto</a></li>
        </ul>
        <div class="nav-actions">
            <button aria-label="Buscar"><span class="material-symbols-outlined">search</span></button>
            <button aria-label="Carrito"><span class="material-symbols-outlined">shopping_cart</span></button>
            <button class="nav-toggle" aria-label="Menú"><span class="material-symbols-outlined">menu</span></button>
        </div>
    </div>
</nav>

<style>
    nav {
        position: sticky;
        top: 0;
        z-index: 100;
        /* Premium Glassmorphism */
        background: color-mix(in srgb, var(--bg) 85%, transparent);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
        padding: 1.25rem 0;
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.02);
        transition: padding 0.3s ease;
    }
    .nav-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .nav-brand {
        font-family: var(--font-display);
        font-size: 32px;
        font-weight: 700;
        color: var(--fg);
        text-decoration: none;
        letter-spacing: -0.02em;
        transition: opacity var(--anim-hover-duration) ease;
    }
    .nav-brand:hover {
        opacity: 0.8;
    }
    .nav-links {
        display: flex;
        gap: 0.5rem;
        list-style: none;
    }
    .nav-links a {
        font-size: 14px;
        font-weight: 600;
        color: var(--muted);
        text-decoration: none;
        padding: 0.6rem 1.25rem;
        border-radius: 99px;
        transition: all var(--anim-hover-duration) ease;
    }
    .nav-links a:hover,
    .nav-links a.active {
        background-color: var(--soft-blush);
        color: var(--accent-deep);
        transform: translateY(-2px);
    }
    .nav-actions {
        display: flex;
        gap: 0.5rem;
        align-items: center;
    }
    .nav-actions button {
        background: transparent;
        border: none;
        cursor: pointer;
        color: var(--muted);
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all var(--anim-hover-duration) ease;
    }
    .nav-actions button span {
        font-size: 22px;
    }
    .nav-actions button:hover {
        color: var(--accent-deep);
        background: var(--soft-blush);
        transform: translateY(-2px);
    }
    .nav-toggle {
        display: none;
    }
</style>
