---
import { Image } from 'astro:assets';

interface Props {
  image: any;
  alt: string;
  category: string;
  name: string;
  price: string;
  tag?: string;
}

const { image, alt, category, name, price, tag } = Astro.props;
---

<article class="product-card">
  <div class="product-image">
    <Image src={image} alt={alt} width={600} height={600} />
    {tag && <span class="product-tag">{tag}</span>}
    <div class="product-overlay">
      <a href="https://drive.google.com/drive/folders/1zpCZNG4K5TVL329bn4_T86Kv-3FNNiFy?usp=drive_link" target="_blank" rel="noopener noreferrer" class="add-to-cart" aria-label={`Ver ${name} en Catálogo`}>
        <span class="material-symbols-outlined">visibility</span>
        Ver Catálogo
      </a>
    </div>
  </div>
  <div class="product-info">
    <p class="product-category">{category}</p>
    <h3 class="product-name">{name}</h3>
    <p class="product-price">{price}</p>
  </div>
</article>

<style>
  .product-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    overflow: hidden;
    transition: all 0.3s;
    display: flex;
    flex-direction: column;
  }
  .product-card:hover {
    border-color: var(--accent);
    box-shadow: 0 10px 30px rgba(197, 160, 89, 0.1);
  }
  .product-image {
    position: relative;
    background: var(--cream);
    aspect-ratio: 1;
    overflow: hidden;
  }
  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }
  .product-card:hover .product-image img {
    transform: scale(1.05);
  }
  .product-tag {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: #F9F1E2;
    color: var(--accent-deep);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
  }
  .product-overlay {
    position: absolute;
    inset: 0;
    background: rgba(26,26,26,0.1);
    opacity: 0;
    transition: opacity 0.3s;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 1.5rem;
  }
  .product-card:hover .product-overlay {
    opacity: 1;
  }
  .add-to-cart {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    background: rgba(255, 255, 255, 0.85);
    color: var(--fg, #1A1A1A);
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transform: translateY(16px);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
  }
  .product-card:hover .add-to-cart {
    transform: translateY(0);
  }
  .add-to-cart:hover {
    background: var(--surface);
    color: var(--accent-deep);
    border-color: var(--accent);
    box-shadow: 0 6px 20px rgba(197, 160, 89, 0.2);
  }
  .add-to-cart .material-symbols-outlined {
    font-size: 18px;
  }
  .product-info {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .product-category {
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.375rem;
  }
  .product-name {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    color: var(--fg);
    line-height: 1.3;
    margin-bottom: 0.75rem;
  }
  .product-price {
    font-size: 16px;
    font-weight: 600;
    color: var(--fg);
    margin-top: auto;
  }
</style>
